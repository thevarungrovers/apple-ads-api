# Never commit key material or credentials
*.pem
.env
.env.*
!.env.example

# Python
venv/
.venv/
__pycache__/
*.pyc

# Report output
reports/

# Kill switch, and the retired JSONL ledger kept as a frozen backup
.audit/

# The log database: every tool call, API call and mutation (real entity ids).
# -wal and -shm are WAL sidecars; they are never worth committing either.
logs/

# Guardrail overrides are committed; local experiments are not
guardrails.local.toml
