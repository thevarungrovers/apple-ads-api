# Copy to .env and fill in the values. .env is gitignored; this file is not, so it
# carries key NAMES and empty values only -- never a real id. This repo is public.

# --- Credentials -------------------------------------------------------------
# ads.apple.com -> Account Settings -> API -> Generate API Client.
# The clientId and teamId are usually the SAME SEARCHADS.<uuid> string; keep them
# in their own keys anyway, because a swap is invisible on inspection and only
# shows up as a server-side rejection.
APPLE_ADS_CLIENT_ID=
APPLE_ADS_TEAM_ID=
APPLE_ADS_KEY_ID=

# --- Account identifiers -----------------------------------------------------
# orgId, shown in the Apple Ads UI under Account Settings. Narrows the ACL
# candidates when test_platform_connection.py discovers your adAccountId; it
# cannot decide between them on its own. Required: nothing defaults it.
APPLE_ADS_ORG_ID=

# adAccountId for the Apple Ads Platform API (api.ads.apple.com/v1), sent as
# `X-AP-Context: adAccountId=<id>;`. This is NOT the org id -- Apple returns them
# as separate fields on the same ACL record. Do not look it up in the UI and do
# not guess it: run `./venv/bin/python test_platform_connection.py`, which reads
# it back from GET /acls and prints the line to paste here.
APPLE_ADS_AD_ACCOUNT_ID=

# Optional. Default for `fetch_ad_structure.py --campaign` and for doc examples,
# so no real campaign id has to appear in source.
APPLE_ADS_DEFAULT_CAMPAIGN_ID=

# --- Write scope -------------------------------------------------------------
# Optional, and the strongest control here: a comma-separated allowlist of the
# only campaigns any apply_* may touch. Anything outside the list fails the
# `campaign_scope` guardrail at preview time, so the apply is refused before it
# is ever offered to a human. EMPTY MEANS EVERY CAMPAIGN IS IN SCOPE -- the
# permissive default, so set this if you want writes pinned.
# Lives here rather than in guardrails.toml because campaign ids are real
# identifiers and this repo is public. A list in guardrails.toml wins over this.
APPLE_ADS_ALLOWED_CAMPAIGN_IDS=
